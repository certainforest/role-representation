def load_model_for_id(model_id: str):
    cache_dir = os.environ.get("HUGGINGFACE_HUB_CACHE")
    tokenizer = AutoTokenizer.from_pretrained(model_id, cache_dir=cache_dir, token=AUTH_TOKEN)
    if tokenizer.pad_token is None:
        tokenizer.pad_token = tokenizer.eos_token

    dtype = torch.bfloat16 if device == "cuda" else torch.float32

    config = AutoConfig.from_pretrained(model_id, cache_dir=cache_dir, token=AUTH_TOKEN)
    if not isinstance(rp, dict) or "rope_type" not in rp:
        rs = config.rope_scaling
        if "type" not in rs or "factor" not in rs or len(rs) != 2:
            config.rope_scaling = {"type": "linear", "factor": float(rs.get("factor", 1.0))}

    model = AutoModelForCausalLM.from_pretrained(
        model_id,
        config=config,
        torch_dtype=dtype,
        device_map="auto" if device == "cuda" else None,
        cache_dir=cache_dir,
        token=AUTH_TOKEN,
    )

    if len(tokenizer) > model.get_input_embeddings().num_embeddings:
        model.resize_token_embeddings(len(tokenizer))

    model.eval()
    return model, tokenizer


def mean_projection_by_label(proj, labels):
    labels = np.array(labels)
    mean_a = proj[labels == "Alice"].mean()
    mean_b = proj[labels == "Bob"].mean()
    return float(mean_a), float(mean_b), float(mean_a - mean_b)


def run_all_for_model(model_id: str):
    global model, tokenizer
    model, tokenizer = load_model_for_id(model_id)

    # Base activations
    turns = parse_turns(TRANSCRIPT_TURNS, TURN_SPEAKERS)
    hidden_states, offsets = extract_hidden_states(FULL_TEXT)
    token_turn_idx, token_speakers = label_tokens_by_turn(offsets, turns)

    # Role difference vectors
    role_diffs = compute_role_diff_vectors(hidden_states, token_speakers)
    role_norms = [float(np.linalg.norm(v)) for v in role_diffs]
    role_vecs = [v / (np.linalg.norm(v) + 1e-8) for v in role_diffs]

    # PCA summary
    layer_for_pca = LAYER_FOR_PCA
    hs = np.asarray(hidden_states[layer_for_pca])
    mask_a = np.array([s == "Alice" for s in token_speakers])
    mask_b = np.array([s == "Bob" for s in token_speakers])
    mean_a = hs[mask_a].mean(axis=0)
    mean_b = hs[mask_b].mean(axis=0)

    hs_centered = hs.copy()
    hs_centered[mask_a] -= mean_a
    hs_centered[mask_b] -= mean_b

    pca = PCA(n_components=2)
    pca_centered = PCA(n_components=2)
    pca.fit(hs)
    pca_centered.fit(hs_centered)

    # Swap-name test
    swapped_turns = swap_names_in_intro(TRANSCRIPT_TURNS)
    swapped_text = "\n".join(swapped_turns)
    swapped_states, swapped_offsets = extract_hidden_states(swapped_text)
    swapped_meta = parse_turns(swapped_turns, TURN_SPEAKERS)
    _, swapped_speakers = label_tokens_by_turn(swapped_offsets, swapped_meta)

    hs_index = layer_for_pca if layer_for_pca >= 0 else len(hidden_states) + layer_for_pca
    role_vec = role_vecs[hs_index]

    swapped_hs = np.asarray(swapped_states[hs_index])
    proj_swapped = swapped_hs @ role_vec

    content_speakers = [turns[i]["speaker"] if i is not None else "UNKNOWN" for i in token_turn_idx]
    swapped_means = mean_projection_by_label(proj_swapped, swapped_speakers)
    content_means = mean_projection_by_label(proj_swapped, content_speakers)

    # Activation patching sweep
    base_name_positions = {name: find_name_positions(FULL_TEXT, name, max_hits=1) for name in NAME_TARGETS}

    donor_texts = {
        "swap_intro": "\n".join(corrupt_intro_names(TRANSCRIPT_TURNS, mode="swap")),
        "mask_intro": "\n".join(corrupt_intro_names(TRANSCRIPT_TURNS, mode="mask")),
        "random_intro": "\n".join(corrupt_intro_names(TRANSCRIPT_TURNS, mode="random")),
    }

    def run_patch_eval(donor_text, layer_idx):
        donor_vecs = compute_donor_vectors(donor_text, layer_idx)
        patch_positions = []
        patch_vectors = []
        for name in NAME_TARGETS:
            if base_name_positions[name]:
                patch_positions.append(base_name_positions[name][0])
                patch_vectors.append(donor_vecs[name])

        if not patch_positions:
            raise ValueError("No base name positions found to patch")

        patched_hs, _ = run_with_patch(FULL_TEXT, layer_idx, patch_positions, patch_vectors)

        base_gap = role_projection_gap(hidden_states, token_speakers, layer_idx + 1, role_vecs[layer_idx + 1])
        patched_gap = role_projection_gap(patched_hs, token_speakers, layer_idx + 1, role_vecs[layer_idx + 1])
        return float(base_gap), float(patched_gap), float(patched_gap - base_gap)

    layers = list(range(len(get_decoder_layers(model))))
    step = max(1, len(layers) // 8)
    layers = layers[::step]

    patch_results = {key: [] for key in donor_texts}
    for layer_idx in layers:
        for key, donor_text in donor_texts.items():
            _base_gap, _patched_gap, delta = run_patch_eval(donor_text, layer_idx)
            patch_results[key].append(delta)

    result = {
        "model_id": model_id,
        "role_norms": role_norms,
        "pca_raw_variance": pca.explained_variance_ratio_.tolist(),
        "pca_centered_variance": pca_centered.explained_variance_ratio_.tolist(),
        "swap_name_test": {
            "swapped_intro_mean_a": swapped_means[0],
            "swapped_intro_mean_b": swapped_means[1],
            "swapped_intro_gap": swapped_means[2],
            "content_mean_a": content_means[0],
            "content_mean_b": content_means[1],
            "content_gap": content_means[2],
        },
        "patching": {
            "layers": layers,
            "deltas": patch_results,
        },
    }

    # Cleanup between models
    if torch.cuda.is_available():
        torch.cuda.empty_cache()

    return result


all_results = []
for mid in MODEL_IDS:
    print("Running:", mid)
    res = run_all_for_model(mid)
    all_results.append(res)
    out_path = OUTPUT_DIR / (mid.replace("/", "__") + "_role_binding.json")
    out_path.write_text(json.dumps(res, indent=2))
    print("Saved:", out_path)

print("Done. Models:", [r["model_id"] for r in all_results])





import json
from pathlib import Path

plot_dir = Path("outputs/role_binding")
json_paths = sorted(plot_dir.glob("*_role_binding.json"))

if not json_paths:
    raise FileNotFoundError(f"No JSON results found in {plot_dir.resolve()}")

results = [json.loads(p.read_text()) for p in json_paths]
model_ids = [r["model_id"] for r in results]

# 1) Role diff norm by layer (overlay)
plt.figure(figsize=(7, 4))
for r in results:
    plt.plot(r["role_norms"], marker="o", label=r["model_id"])
plt.title("Role diff norm by layer")
plt.xlabel("Layer (0 = embeddings)")
plt.ylabel("L2 norm")
plt.legend(fontsize=8)
plt.show()

# 2) PCA variance (raw vs centered) per model
x = np.arange(len(model_ids))
raw = [r["pca_raw_variance"][0] for r in results]
centered = [r["pca_centered_variance"][0] for r in results]

plt.figure(figsize=(7, 4))
plt.bar(x - 0.2, raw, width=0.4, label="raw PC1")
plt.bar(x + 0.2, centered, width=0.4, label="centered PC1")
plt.xticks(x, model_ids, rotation=25, ha="right")
plt.ylabel("Explained variance")
plt.title("PCA PC1 variance (raw vs centered)")
plt.legend()
plt.tight_layout()
plt.show()

# 3) Swap-name test gaps
swap_gaps = [r["swap_name_test"]["swapped_intro_gap"] for r in results]
content_gaps = [r["swap_name_test"]["content_gap"] for r in results]

plt.figure(figsize=(7, 4))
plt.bar(x - 0.2, swap_gaps, width=0.4, label="swapped intro gap")
plt.bar(x + 0.2, content_gaps, width=0.4, label="content gap")
plt.xticks(x, model_ids, rotation=25, ha="right")
plt.ylabel("Role projection gap")
plt.title("Swap-name test (role gap)")
plt.legend()
plt.tight_layout()
plt.show()

# 4) Patching deltas by layer (one plot per corruption)
patch_keys = list(results[0]["patching"]["deltas"].keys())

for key in patch_keys:
    plt.figure(figsize=(7, 4))
    for r in results:
        layers = r["patching"]["layers"]
        deltas = r["patching"]["deltas"][key]
        plt.plot(layers, deltas, marker="o", label=r["model_id"])
    plt.axhline(0.0, color="k", linewidth=1, alpha=0.6)
    plt.title(f"Patching delta by layer: {key}")
    plt.xlabel("Decoder layer")
    plt.ylabel("Delta (patched - base)")
    plt.legend(fontsize=8)
    plt.tight_layout()
    plt.show()



