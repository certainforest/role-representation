def get_decoder_layers(model):
    """Best-effort: return the ModuleList of decoder blocks across HF architectures."""

    def _is_layer_list(x):
        if isinstance(x, torch.nn.ModuleList):
            return len(x) > 0
        if isinstance(x, (list, tuple)) and len(x) > 0:
            return isinstance(x[0], torch.nn.Module)
        return False

    def _maybe_get(obj, attrs):
        cur = obj
        for a in attrs:
            if cur is None or not hasattr(cur, a):
                return None
            cur = getattr(cur, a)
        return cur

    # Common explicit paths.
    for path in (
        ("model", "layers"),  # Llama/Mistral/Gemma/Gemma2
        ("base_model", "model", "layers"),
        ("model", "decoder", "layers"),
        ("model", "layers", "layers"),  # some wrappers
        ("transformer", "h"),  # GPT-2 / Falcon-like
        ("gpt_neox", "layers"),
        ("transformer", "blocks"),  # some OLMo-style
        ("model", "blocks"),
    ):
        x = _maybe_get(model, path)
        if _is_layer_list(x):
            return x

    # Config-guided fallback: find a ModuleList whose length matches num layers.
    cfg = getattr(model, "config", None)
    target_n = None
    for k in ("num_hidden_layers", "n_layer", "num_layers", "n_layers"):
        v = getattr(cfg, k, None) if cfg is not None else None
        if isinstance(v, int) and v > 0:
            target_n = v
            break

    best = None
    best_len = 0
    for m in model.modules():
        if isinstance(m, torch.nn.ModuleList) and len(m) > 0:
            if target_n is not None and len(m) == target_n:
                return m
            if len(m) > best_len:
                best = m
                best_len = len(m)

    if best is not None:
        return best

    raise AttributeError(
        "Could not find decoder layers on this model. "
        "Tried common paths and a ModuleList scan."
    )


def find_subsequence_positions(sequence, pattern):
    if not pattern or len(pattern) > len(sequence):
        return []
    out = []
    m = len(pattern)
    for i in range(len(sequence) - m + 1):
        if sequence[i : i + m] == pattern:
            out.append(i)
    return out


def find_name_positions(text, name, max_hits=1):
    ids = tokenizer(text, add_special_tokens=False).input_ids
    patterns = [
        tokenizer.encode(name, add_special_tokens=False),
        tokenizer.encode(" " + name, add_special_tokens=False),
    ]
    hits = []
    for pat in patterns:
        hits.extend(find_subsequence_positions(ids, pat))
    hits = sorted(list(dict.fromkeys(hits)))
    return hits[:max_hits]


def role_projection_gap(hidden_states, token_speakers, hs_index, role_vec):
    hs = np.asarray(hidden_states[hs_index])
    role_vec = np.asarray(role_vec)
    if hs.shape[-1] != role_vec.shape[0]:
        raise ValueError(
            f"Hidden size mismatch at hs_index={hs_index}: "
            f"hidden_states dim={hs.shape[-1]} vs role_vec dim={role_vec.shape[0]}. "
            "This usually means role vectors were computed using a different model; "
            "recompute base hidden states/role vectors after loading the current model."
        )
    proj = hs @ role_vec
    mask_a = np.array([s == "Alice" for s in token_speakers])
    mask_b = np.array([s == "Bob" for s in token_speakers])
    return proj[mask_a].mean() - proj[mask_b].mean()


def run_with_patch(text, layer_idx, patch_positions, patch_vectors):
    """Patch specified token positions at a given decoder layer.

    layer_idx refers to the decoder layer index (0-based).
    patch_positions is a list of token indices in the *base* text.
    patch_vectors is a list of vectors aligned with patch_positions.
    """
    input_ids, offsets = tokenize_with_offsets(text)
    input_ids = input_ids.to(model.device)

    layers = get_decoder_layers(model)
    layer = layers[layer_idx]

    model_dtype = next(model.parameters()).dtype
    patch_tensors = [
        torch.tensor(vec, device=model.device, dtype=model_dtype)
        for vec in patch_vectors
    ]

    def hook_fn(_module, _inputs, output):
        hs = output[0] if isinstance(output, tuple) else output
        hs = hs.clone()
        for pos, vec in zip(patch_positions, patch_tensors):
            if pos < hs.shape[1]:
                hs[:, pos, :] = vec
        if isinstance(output, tuple):
            return (hs,) + output[1:]
        return hs

    handle = layer.register_forward_hook(hook_fn)
    with torch.no_grad():
        outputs = model(input_ids, output_hidden_states=True)
    handle.remove()

    hidden_states = [hs[0].float().cpu().numpy() for hs in outputs.hidden_states]
    return hidden_states, offsets


def corrupt_intro_names(turns, mode="mask"):
    """Corrupt names only in the first two turns."""
    out = list(turns)
    if len(out) < 2:
        return out

    if mode == "swap":
        for i in (0, 1):
            tmp = out[i].replace("Alice", "__TEMP__")
            tmp = tmp.replace("Bob", "Alice")
            out[i] = tmp.replace("__TEMP__", "Bob")
        return out

    if mode == "mask":
        for i in (0, 1):
            out[i] = out[i].replace("Alice", "Speaker").replace("Bob", "Speaker")
        return out

    if mode == "random":
        for i in (0, 1):
            out[i] = out[i].replace("Alice", "Casey").replace("Bob", "Jordan")
        return out

    return out


BASE_TEXT = FULL_TEXT
DONOR_TEXTS = {
    "swap_intro": "\n".join(corrupt_intro_names(TRANSCRIPT_TURNS, mode="swap")),
    "mask_intro": "\n".join(corrupt_intro_names(TRANSCRIPT_TURNS, mode="mask")),
    "random_intro": "\n".join(corrupt_intro_names(TRANSCRIPT_TURNS, mode="random")),
}
NAME_TARGETS = ["Alice", "Bob"]

# IMPORTANT: recompute base activations/vectors for the CURRENT global model.
_base_turns = parse_turns(TRANSCRIPT_TURNS, TURN_SPEAKERS)
base_hidden_states, base_offsets = extract_hidden_states(BASE_TEXT)
_, base_token_speakers = label_tokens_by_turn(base_offsets, _base_turns)

base_name_positions = {name: find_name_positions(BASE_TEXT, name, max_hits=1) for name in NAME_TARGETS}

base_role_diffs = compute_role_diff_vectors(base_hidden_states, base_token_speakers)
role_vecs = []
for v in base_role_diffs:
    n = np.linalg.norm(v) + 1e-8
    role_vecs.append(v / n)


def compute_donor_vectors(text, layer_idx):
    hs, _ = extract_hidden_states(text)
    hs_index = layer_idx + 1
    vecs = {}
    for name in NAME_TARGETS:
        donor_pos = find_name_positions(text, name, max_hits=1)
        if not donor_pos:
            raise ValueError(f"No '{name}' token positions found in donor text")
        vecs[name] = np.asarray(hs[hs_index])[donor_pos].mean(axis=0)
    return vecs


def run_patch_eval(donor_text, layer_idx):
    hs_index = layer_idx + 1
    donor_vecs = compute_donor_vectors(donor_text, layer_idx)

    patch_positions = []
    patch_vectors = []
    for name in NAME_TARGETS:
        if base_name_positions[name]:
            patch_positions.append(base_name_positions[name][0])
            patch_vectors.append(donor_vecs[name])

    if not patch_positions:
        raise ValueError("No base name positions found to patch")

    patched_hs, _ = run_with_patch(BASE_TEXT, layer_idx, patch_positions, patch_vectors)

    base_gap = role_projection_gap(base_hidden_states, base_token_speakers, hs_index, role_vecs[hs_index])
    patched_gap = role_projection_gap(patched_hs, base_token_speakers, hs_index, role_vecs[hs_index])
    return base_gap, patched_gap, patched_gap - base_gap


# Single-layer demo
PATCH_LAYER = min(8, len(get_decoder_layers(model)) - 1)
for name, donor_text in DONOR_TEXTS.items():
    base_gap, patched_gap, delta = run_patch_eval(donor_text, PATCH_LAYER)
    print(f"{name} | layer {PATCH_LAYER}: base={base_gap:.4f}, patched={patched_gap:.4f}, delta={delta:.4f}")


# Layer sweep for causal localization
layers = list(range(len(get_decoder_layers(model))))
step = max(1, len(layers) // 8)
layers = layers[::step]

results = {key: [] for key in DONOR_TEXTS}
for layer_idx in layers:
    for key, donor_text in DONOR_TEXTS.items():
        _base_gap, _patched_gap, delta = run_patch_eval(donor_text, layer_idx)
        results[key].append(delta)

plt.figure(figsize=(7, 4))
for key, deltas in results.items():
    plt.plot(layers, deltas, marker="o", label=key)
plt.axhline(0.0, color="k", linewidth=1, alpha=0.6)
plt.title("Activation patching effect by layer (delta role gap)")
plt.xlabel("Decoder layer")
plt.ylabel("Delta (patched - base)")
plt.legend()
plt.show()








